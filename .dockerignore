.git
.claude
.gitignore

# Large local artifacts -- excluded from the build context to keep builds fast;
# docker-compose.yml bind-mounts the real Results/ folder into the container
# at runtime instead, so the model weights never need to be in the image.
Results-20260913T045822Z-1-001.zip
Results-20260913T045822Z-1-001/Results/**/*.keras
Results-20260913T045822Z-1-001/Results/**/*.h5

# Python virtual environments
.venv/
webapp/.venv/
**/__pycache__/
*.pyc

# Flask runtime uploads
webapp/static/uploads/*
!webapp/static/uploads/.gitkeep

# Editor / OS
.vscode/
.DS_Store
Thumbs.db
